{
  "name": "@daaveuk/daaveuk.github.io",
  "version": "0.1.0",
  "homepage": "https://daaveuk.github.io",
  "private": true,
  "dependencies": {
    "@astrojs/node": "^9.2.2",
    "@astrojs/react": "^4.3.0",
    "@astrojs/sitemap": "^3.4.1",
    "@vanilla-extract/css": "^1.17.4",
    "astro": "^5.9.4",
    "react": "^17.0.1",
    "react-dom": "^17.0.1"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --ignore-pattern \"**/*.astro\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --ignore-pattern \"**/*.astro\" --fix",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "cypress:run:headed": "cypress run --headed",
    "cypress:run:spec": "cypress run --spec",
    "test:e2e": "start-server-and-test dev http://localhost:4321 cypress:run",
    "test:all": "npm run test:run && npm run test:e2e"
  },
  "devDependencies": {
    "@testing-library/cypress": "^10.0.3",
    "@testing-library/jest-dom": "^5.11.6",
    "@testing-library/react": "^11.1.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^2.34.0",
    "@typescript-eslint/parser": "^2.34.0",
    "@vanilla-extract/vite-plugin": "^5.0.6",
    "@vitest/coverage-v8": "^3.2.3",
    "cypress": "^14.4.1",
    "eslint": "^5.16.0",
    "jsdom": "^25.0.1",
    "start-server-and-test": "^2.0.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
