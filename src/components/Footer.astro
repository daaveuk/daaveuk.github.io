---
// Footer component - static content except theme toggle
---

<footer>
  <slot />
</footer>

<style>
  footer {
    font-family: var(--font-family);
    font-weight: var(--font-weight-regular);
    font-size: 0.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    width: 100%;
    gap: 0.5rem;
    margin-top: auto;
    background: var(--color-body);
    border-top: 1px solid var(--color-background-accent);
  }

  @media (min-width: 768px) {
    footer {
      flex-direction: row;
      justify-content: space-between;
      padding: 2rem;
      max-width: 1440px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
