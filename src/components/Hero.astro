---
// Hero component - static content
---

<header>
  <div class="header-background">
    <div class="container">
      <slot />
    </div>
  </div>
</header>

<style>
  .container {
    text-align: left;
    transform: translateY(2rem);
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    flex-grow: 0;
  }

  @media (min-width: 768px) {
    .container {
      margin: 0 auto;
      flex-direction: column;
      max-width: 1440px;
      padding: 0 2rem;
    }
  }

  .header-background {
    min-height: 6rem;
    margin-bottom: 3rem;
    background: var(--color-header-gradient);
  }

  @media (min-width: 768px) {
    .header-background {
      min-height: 9rem;
      margin-bottom: 3rem;
    }
  }
</style>
