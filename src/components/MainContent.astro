---
// MainContent component - static content
---

<main id="main-content">
  <slot />
</main>

<style>
  main {
    font-family: var(--font-family);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
    padding: 0 var(--container-padding-mobile) var(--space-xl);
    margin: 0 auto;
    max-width: var(--container-max-width);
    flex: 1;
  }

  @media (min-width: 768px) {
    main {
      padding: 0 var(--container-padding-desktop) var(--space-xl);
    }

    main::before {
      left: var(--container-padding-desktop);
      right: var(--container-padding-desktop);
    }
  }

  /* Section spacing and structure */
  section {
    margin-bottom: var(--space-xl);
    background: rgba(255, 255, 255, 0.8);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    border: 1px solid var(--color-background-accent);
    backdrop-filter: blur(10px);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  /* Dark theme section background */
  [data-theme="dark"] section {
    background: rgba(17, 17, 17, 0.8);
  }

  section:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px var(--color-hover-shadow);
  }

  section:last-child {
    margin-bottom: 0;
  }

  /* Respect user motion preferences for sections */
  @media (prefers-reduced-motion: reduce) {
    section {
      transition: none;
    }

    section:hover {
      transform: none;
      box-shadow: 0 0 0 2px var(--color-focus-ring);
    }
  }

  /* Social media links container */
  [role="list"] {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-base);
  }

  /* Screen reader only headings */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
