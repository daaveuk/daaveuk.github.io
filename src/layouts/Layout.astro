---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      // Theme management
      const getInitialTheme = () => {
        const localTheme = localStorage.getItem('theme');
        if (localTheme) {
          return localTheme;
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const applyTheme = (theme) => {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
      };

      // Apply initial theme
      applyTheme(getInitialTheme());

      // Export theme functions to global scope
      window.toggleTheme = () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(newTheme);

        // Dispatch custom event for theme change
        window.dispatchEvent(new CustomEvent('themeChange', { detail: { theme: newTheme } }));
      };
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Light theme colors */
    --color-body: #FFFFFE;
    --color-background-accent: #EBECF0;
    --color-text: #45525F;
    --color-header-gradient: linear-gradient(142.5deg, #EBECF0 -0.86%, #FFFFFE 86.05%);
    --color-button-gradient: linear-gradient(270deg, #f58555 0%, #e67272 100%);
    --color-hover-shadow: #A9B2BB;

    /* Typography */
    --font-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-weight-thin: 100;
    --font-weight-light: 300;
    --font-weight-regular: 400;
    --font-weight-bold: 700;
    --font-weight-black: 900;

    /* Font sizes */
    --font-size-xs: 0.8rem;
    --font-size-sm: 1rem;
    --font-size-base: 1rem;
    --font-size-lg: 1.25rem;
    --font-size-xl: 1.5rem;
    --font-size-2xl: 2rem;
    --font-size-3xl: 3rem;
    --font-size-4xl: 4rem;
    --font-size-5xl: 5rem;

    /* Line heights */
    --line-height-tight: 1.2;
    --line-height-normal: 1.5;
    --line-height-relaxed: 1.75;
    --line-height-button: 3rem;

    /* Spacing scale */
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 0.75rem;
    --space-base: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-2xl: 3rem;
    --space-3xl: 4rem;
    --space-4xl: 5rem;

    /* Border radius */
    --radius-sm: 0.25rem;
    --radius-md: 0.5rem;
    --radius-lg: 1rem;
    --radius-xl: 1.5rem;
    --radius-full: 50%;

    /* Container and layout */
    --container-max-width: 1440px;
    --container-padding-mobile: var(--space-base);
    --container-padding-desktop: var(--space-xl);

    /* Breakpoints (for reference in media queries) */
    --breakpoint-tablet: 768px;
    --breakpoint-desktop: 1281px;

    /* Component-specific sizes */
    --button-height: var(--line-height-button);
    --button-padding-x: var(--space-base);
    --icon-button-size: var(--space-2xl);
    --profile-picture-size: var(--space-3xl);

    /* Borders */
    --border-width-thin: 1px;
    --border-width-medium: 2px;
    --border-width-thick: 3px;
  }

  [data-theme="dark"] {
    /* Dark theme colors */
    --color-body: #45525F;
    --color-background-accent: #2A3541;
    --color-text: #E9F0F8;
    --color-header-gradient: linear-gradient(113.53deg, #2A3541 0%, rgba(57, 70, 83, 0) 86.04%);
    --color-button-gradient: linear-gradient(270deg, #f58555 0%, #e67272 100%);
    --color-hover-shadow: #0a0e13c4;
  }

  *,
  *::after,
  *::before {
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  html {
    font-size: var(--font-size-base);
  }

  body {
    background: var(--color-body);
    color: var(--color-text);
    margin: 0;
    padding: 0;
    font-family: var(--font-family);
    transition: background-color 0.3s ease, color 0.3s ease;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    html {
      font-size: 18px;
    }
  }

  @media (min-width: 1281px) {
    html {
      font-size: 20px;
    }
  }

  a {
    color: var(--color-text);
    text-decoration: underline;
  }

  .hover-effect {
    position: relative;
    transition: all 0.1s ease-in;
    top: 0;
  }

  .hover-effect:hover {
    top: -2px;
    box-shadow: 0 var(--space-base) var(--space-base) calc(-1 * var(--space-sm)) var(--color-hover-shadow);
  }

  /* Theme Toggle Styles */
  .theme-toggle-wrapper {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .toggle-label {
    margin: 0 var(--space-xs);
  }

  .toggle-container {
    position: relative;
    display: inline-block;
  }

  .toggle-label-switch {
    position: absolute;
    top: 0;
    left: 0;
    width: 47px;
    height: 30px;
    border-radius: 15px;
    border: var(--border-width-thick) solid #e67272;
    background-color: white;
    cursor: pointer;
  }

  .toggle-label-switch::after {
    content: '';
    display: block;
    border-radius: var(--radius-full);
    width: 20px;
    height: 20px;
    margin: 2px;
    background: var(--color-button-gradient);
    transition: 0.2s;
  }

  .toggle-checkbox {
    opacity: 0;
    z-index: 1;
    border-radius: 15px;
    width: 42px;
    height: 26px;
  }

  .toggle-checkbox:checked + .toggle-label-switch::after {
    content: '';
    display: block;
    border-radius: var(--radius-full);
    width: 20px;
    height: 20px;
    background-color: #e67272;
    margin-left: 19px;
    transition: 0.2s;
  }
</style>
