---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import MainContent from '../components/MainContent.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import Title from '../components/Title.astro';
import ProfilePicture from '../components/ProfilePicture.astro';
import Emoji from '../components/Emoji.astro';
import IconButton from '../components/IconButton.astro';
import ThemeToggle from '../components/ThemeToggle/ThemeToggle.tsx';
import { sendEmail } from '../functions/sendEmail.ts';
---

<Layout title="Dave Henderson - Experienced Typescript Engineer, Manchester, UK">
  <Hero>
    <ProfilePicture src="/profilePic.png" />
    <Title testId="title">Ey 'up!</Title>
  </Hero>

  <MainContent>
    <section aria-labelledby="about-heading">
      <h2 id="about-heading" class="sr-only">About me</h2>
      <p>
        I'm Dave, A quaint Yorkshireman living in Manchester. An
        experienced <strong>Principal Typescript Engineer</strong>, I'm passionate
        about Typescript, React, Unit testing, UX and Accessibility.
      </p>
      <p>
        I'm currently part of a great team building great products at{' '}
        <strong>Interactive Investor</strong>.
      </p>
    </section>

    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="sr-only">Get in touch</h2>
      <p>Always happy for a chat! Why not drop me a line?</p>
      <Button href={sendEmail()}>
        <Emoji label="Email icon" symbol="📬" /> Get In Touch
      </Button>
    </section>

    <section aria-labelledby="social-heading">
      <h2 id="social-heading" class="sr-only">Find me online</h2>
      <p>You can also find me here!</p>
      <div role="list" aria-label="Social media links">
        <IconButton href="https://twitter.com/daaveuk/" icon="twitter" />
        <IconButton
          href="https://www.linkedin.com/in/daaveuk/"
          icon="linkedin"
        />
        <IconButton href="https://github.com/daaveuk/" icon="github" />
      </div>
    </section>
  </MainContent>

  <Footer>
    <ThemeToggle id="themeToggle" client:load />
    <span>
      Made with <Emoji label="Love" symbol="❤️" /> by David Henderson.
    </span>
    <span>
      <a
        href="https://github.com/daaveuk/webpage"
        target="_blank"
        rel="noreferrer noopener"
      >
        View the code here.
      </a>
    </span>
  </Footer>
</Layout>
