---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.jsx';
import { sendEmail } from '../functions/sendEmail.js';
---

<Layout title="Dave Henderson - Front End Developer">
  <header>
    <div class="header-background">
      <div class="container">
        <div class="profile-picture">
          <img src="/profilePic.png" alt="Dave Henderson Profile Picture" />
        </div>
        <h1 data-testid="title">Ey 'up!</h1>
      </div>
    </div>
  </header>
  
  <main>
    <div>
      <p>
        I'm Dave, A quaint Yorkshireman living in Manchester. An
        experienced <strong>Front End Developer</strong>, I'm passionate
        about Javascript, Unit testing, UX and Accessibility.
      </p>
      <p>
        I'm currently part of a great team building great products at{' '}
        <strong>Interactive Investor</strong>.
      </p>
      <br />
      <p>Always happy for a chat! Why not drop me a line?</p>
      <a href={sendEmail()} class="button hover-effect">
        <span role="img" aria-label="Email icon">📬</span> Get In Touch
      </a>
      <p>You can also find me here!</p>
      <a href="https://twitter.com/daaveuk/" target="_blank" rel="noreferrer noopener" class="icon-button hover-effect twitter">
        <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>Twitter</title><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/daaveuk/" target="_blank" rel="noreferrer noopener" class="icon-button hover-effect linkedin">
        <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>LinkedIn</title><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="https://github.com/daaveuk/" target="_blank" rel="noreferrer noopener" class="icon-button hover-effect github">
        <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>GitHub</title><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
    </div>
  </main>
  
  <footer>
    <ThemeToggle id="themeToggle" client:load />
    <span>
      Made with <span role="img" aria-label="Love">❤️</span> by David Henderson.
    </span>
    <span>
      <a
        href="https://github.com/daaveuk/webpage"
        target="_blank"
        rel="noreferrer noopener"
      >
        View the code here.
      </a>
    </span>
  </footer>
</Layout>

<style>
  /* Hero/Header styles */
  .container {
    text-align: left;
    transform: translateY(2rem);
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    flex-grow: 0;
  }

  @media (min-width: 768px) {
    .container {
      transform: translateY(6rem);
      margin: 0 auto;
      flex-direction: row;
      max-width: 1440px;
    }
  }

  .header-background {
    min-height: 6rem;
    margin-bottom: 3rem;
    background: var(--color-header-gradient);
  }

  @media (min-width: 768px) {
    .header-background {
      min-height: 9rem;
      margin-bottom: 3rem;
    }
  }

  /* Profile Picture styles */
  .profile-picture {
    margin-right: 2rem;
    margin-bottom: 1rem;
  }

  .profile-picture img {
    border-radius: 50%;
    width: 200px;
    height: 200px;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .profile-picture {
      margin-bottom: 0;
    }
  }

  /* Title styles */
  h1 {
    font-size: 3rem;
    margin: 0;
    font-weight: 700;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 4rem;
    }
  }

  @media (min-width: 1281px) {
    h1 {
      font-size: 5rem;
    }
  }

  /* Main content styles */
  main {
    padding: 0 1rem;
    margin: 0 auto;
    max-width: 1440px;
  }

  @media (min-width: 768px) {
    main {
      padding: 0 2rem;
    }
  }

  /* Button styles */
  .button {
    background: var(--color-button-gradient);
    color: white;
    border-radius: 1.5rem;
    appearance: none;
    border: none;
    line-height: 3rem;
    font-weight: 700;
    cursor: pointer;
    font-size: 1rem;
    display: inline-block;
    padding: 0 1rem;
    text-decoration: none;
    margin-right: 0.5rem;
  }

  /* Icon Button styles */
  .icon-button {
    line-height: 3rem;
    width: 3rem;
    height: 3rem;
    text-align: center;
    border-radius: 50%;
    display: inline-block;
    color: white;
    padding: 0.75rem;
    box-sizing: border-box;
  }

  .icon-button + .icon-button {
    margin-left: 0.5rem;
  }

  .icon-button.twitter {
    background: #1da1f2;
    border: 1px solid #1da1f2;
  }

  .icon-button.linkedin {
    background: #007bb5;
    border: 1px solid #007bb5;
  }

  .icon-button.github {
    background: white;
    border: 1px solid #ddd;
    color: black;
  }

  .icon-button svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* Footer styles */
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    margin-top: 2rem;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    footer {
      flex-direction: row;
      justify-content: space-between;
      padding: 2rem;
      max-width: 1440px;
      margin: 2rem auto 0;
    }
  }
</style>
